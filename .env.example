# --- One Canvas account: stdio, --check, or --http with MCP_SECRET ---
# Your school's Canvas URL (the address you log into, no /api/v1)
CANVAS_BASE_URL=https://yourschool.instructure.com
# Canvas > Account > Settings > Approved Integrations > + New Access Token
CANVAS_API_TOKEN=paste-token-here
# Time zone due dates are shown in
CANVAS_TZ=America/New_York
# HTTP mode only: long random string, becomes part of the URL. Generate with: openssl rand -hex 24
MCP_SECRET=

# --- Multi-user: --http with PUBLIC_URL, every student logs in with their own Canvas ---
# Use these instead of everything above (MCP_SECRET must stay unset); Canvas URL, token and time zone come from each login.
# The server's public origin, no path. Must be https (http only for localhost testing)
#PUBLIC_URL=https://canvas.example.com
# Encrypts every login. Must be random: openssl rand -hex 32 (a guessable key can be cracked offline from any
# token the server hands out, which would expose every student's Canvas token). Changing it logs everyone out.
#CANVAS_MCP_KEY=
# Optional: comma-separated origins allowed to receive logins (Claude apps). The default covers claude.ai,
# claude.com and localhost; leave unset normally.
#CANVAS_MCP_REDIRECT_HOSTS=
# Optional: addresses/subnets of the reverse proxies to believe about client IPs. Not "true" or a hop count.
#TRUST_PROXY=loopback, linklocal, uniquelocal

# --- Both HTTP modes: port/bind (defaults 7341 / 127.0.0.1; the Docker image uses 0.0.0.0) ---
#CANVAS_MCP_PORT=7341
#CANVAS_MCP_HOST=127.0.0.1
